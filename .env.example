# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored. In production, set these in the Vercel dashboard (or `vercel env`).
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the browser / never prefix
# with NEXT_PUBLIC_. Needed only if you add admin/server-side Supabase calls.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
# Public base URL, used to build auth redirect links. In production set this to
# your real domain (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Analytics 4 (optional) ------------------------------------------
# Leave blank to disable analytics entirely (nothing is loaded).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- OpenTelemetry (optional) ------------------------------------------------
# Standard OTEL_* env vars. Point these at any OTLP-compatible backend.
# On Vercel, traces appear in the dashboard even without these set.
OTEL_SERVICE_NAME=ai-builder-template
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.your-backend.io
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token

# ---------------------------------------------------------------------------
# Twilio Verify is configured in the SUPABASE DASHBOARD, not here:
#   Authentication -> Providers -> Phone -> SMS provider = Twilio Verify.
# Supabase stores your Twilio Account SID / Auth Token / Verify Service SID
# server-side, so no Twilio secrets belong in this app's environment.
# ---------------------------------------------------------------------------
